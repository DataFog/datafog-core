{
  "name": "@datafog/wasm",
  "version": "1.3.0",
  "description": "Fast structured PII detection for browsers, powered by Rust and WebAssembly",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DataFog/datafog-core.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "files": [
    "index.js",
    "index.d.ts",
    "dist",
    "models",
    "cnn"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./models": {
      "types": "./models/index.d.ts",
      "import": "./models/index.js"
    },
    "./cnn": {
      "types": "./cnn/index.d.ts",
      "import": "./cnn/index.js"
    },
    "./cnn/workspace": {
      "types": "./cnn/workspace.d.ts",
      "import": "./cnn/workspace.mjs"
    }
  },
  "types": "./index.d.ts",
  "keywords": [
    "pii",
    "privacy",
    "detection",
    "wasm",
    "webassembly"
  ],
  "scripts": {
    "build": "cargo build --manifest-path Cargo.toml --release --target wasm32-unknown-unknown && wasm-bindgen --target web --out-dir dist --out-name datafog_wasm ../../target/wasm32-unknown-unknown/release/datafog_wasm.wasm",
    "test:package": "node ../../scripts/test-wasm-package.mjs"
  },
  "devDependencies": {
    "playwright": "1.65.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "onnxruntime-web": "1.31.1"
  }
}
