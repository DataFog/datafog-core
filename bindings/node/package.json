{
  "name": "@datafog/node",
  "version": "0.2.0",
  "description": "Fast structured PII detection for Node.js, powered by Rust",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DataFog/datafog-core.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "index.js",
    "native.js",
    "index.d.ts",
    "*.node"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "types": "./index.d.ts",
  "engines": {
    "node": "24.x"
  },
  "napi": {
    "binaryName": "datafog",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ],
    "dtsHeaderFile": "dts-header.d.ts"
  },
  "scripts": {
    "build": "napi build --manifest-path Cargo.toml --release --platform --esm --js native.js --dts index.d.ts",
    "test:package": "node ../../scripts/test-node-package.mjs",
    "prepublishOnly": "napi prepublish -t npm --no-gh-release"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.8.6",
    "typescript": "7.0.2"
  }
}
