{
  "name": "@datafog/node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "index.js",
    "native.js",
    "index.d.ts",
    "*.node"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "types": "./index.d.ts",
  "engines": {
    "node": "24.x"
  },
  "napi": {
    "binaryName": "datafog",
    "targets": [
      "aarch64-apple-darwin"
    ],
    "dtsHeaderFile": "dts-header.d.ts"
  },
  "scripts": {
    "build": "napi build --manifest-path Cargo.toml --release --platform --esm --js native.js --dts index.d.ts",
    "test:package": "node ../../scripts/test-node-package.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.8.6",
    "typescript": "7.0.2"
  }
}
