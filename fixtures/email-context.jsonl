{"id": "env-assignment", "config": {"format": "env"}, "text": "SUPPORT_EMAIL=support@example.com", "matches": [{"text": "support@example.com", "start": 14, "end": 33}], "outputs": {"redact": "SUPPORT_EMAIL=[EMAIL]", "mask": "SUPPORT_EMAIL=*******************", "remove": "SUPPORT_EMAIL="}}
{"id": "sql-quotes", "config": {"format": "sql"}, "text": "'li.wei@example.com'", "matches": [{"text": "li.wei@example.com", "start": 1, "end": 19}], "outputs": {"redact": "'[EMAIL]'", "mask": "'******************'", "remove": "''"}}
{"id": "sql-statement", "config": {"format": "sql"}, "text": "INSERT INTO contacts (email) VALUES ('li.wei@example.com');", "matches": [{"text": "li.wei@example.com", "start": 38, "end": 56}], "outputs": {"redact": "INSERT INTO contacts (email) VALUES ('[EMAIL]');", "mask": "INSERT INTO contacts (email) VALUES ('******************');", "remove": "INSERT INTO contacts (email) VALUES ('');"}}
{"id": "env-export", "config": {"format": "env"}, "text": "  export SUPPORT_EMAIL = 'support@example.com' # contact", "matches": [{"text": "support@example.com", "start": 26, "end": 45}], "outputs": {"redact": "  export SUPPORT_EMAIL = '[EMAIL]' # contact", "mask": "  export SUPPORT_EMAIL = '*******************' # contact", "remove": "  export SUPPORT_EMAIL = '' # contact"}}
{"id": "env-equals", "config": {"format": "env"}, "text": "EMAIL=customer=tag@example.com", "matches": [{"text": "customer=tag@example.com", "start": 6, "end": 30}], "outputs": {"redact": "EMAIL=[EMAIL]", "mask": "EMAIL=************************", "remove": "EMAIL="}}
{"id": "env-apostrophe", "config": {"format": "env"}, "text": "EMAIL=o'connor@example.com", "matches": [{"text": "o'connor@example.com", "start": 6, "end": 26}], "outputs": {"redact": "EMAIL=[EMAIL]", "mask": "EMAIL=********************", "remove": "EMAIL="}}
{"id": "env-double-quotes", "config": {"format": "env"}, "text": "EMAIL=\"o'connor=tag@example.com\"", "matches": [{"text": "o'connor=tag@example.com", "start": 7, "end": 31}], "outputs": {"redact": "EMAIL=\"[EMAIL]\"", "mask": "EMAIL=\"************************\"", "remove": "EMAIL=\"\""}}
{"id": "env-multiline", "config": {"format": "env"}, "text": "EMAIL='\nsupport@example.com\n'\nOTHER=other@example.org", "matches": [{"text": "support@example.com", "start": 8, "end": 27}, {"text": "other@example.org", "start": 36, "end": 53}], "outputs": {"redact": "EMAIL='\n[EMAIL]\n'\nOTHER=[EMAIL]", "mask": "EMAIL='\n*******************\n'\nOTHER=*****************", "remove": "EMAIL='\n\n'\nOTHER="}}
