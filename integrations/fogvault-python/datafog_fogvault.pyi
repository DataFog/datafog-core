from typing import Any

__version__: str

class FogVaultWorkspaceError(ValueError):
    code: str
    request_id: bytes
    finding_index: int | None
    input_index: int | None
    marker_issues: list[dict[str, Any]]
    review_conflicts: list[dict[str, Any]]

class WorkspaceHead:
    def __init__(self, revision: int, commit_id: bytes) -> None: ...
    @property
    def revision(self) -> int: ...
    @property
    def commit_id(self) -> bytes: ...

class PreparedChange:
    def previews(self, tenant: str) -> list[dict[str, Any]]: ...
    def heads(self, tenant: str) -> tuple[WorkspaceHead, WorkspaceHead]: ...
    def send_intents(self, tenant: str) -> list[dict[str, Any]]: ...
    def snapshot_format(self, tenant: str) -> dict[str, int]: ...
    def policy_preview(self, tenant: str) -> dict[str, Any] | None: ...
    def discard(self, tenant: str) -> None: ...

class RestoreStream:
    def feed(self, tenant: str, data: bytes) -> dict[str, Any] | None: ...
    def feed_utf16(self, tenant: str, units: list[int]) -> dict[str, Any] | None: ...
    def finalize(self, tenant: str) -> dict[str, Any]: ...
    def reset(self, tenant: str) -> None: ...
    def close(self, tenant: str) -> None: ...

class NativeWorkspace:
    @staticmethod
    def create_new(tenant: str, control_path: str, vault_path: str, password: bytes, record_id: bytes, namespace: bytes, operation_id: bytes, request_id: bytes, *, profile: str = "password_only") -> NativeWorkspace: ...
    @staticmethod
    def open_existing(tenant: str, control_path: str, vault_path: str, password: bytes, record_id: bytes, namespace: bytes, *, expected_head: WorkspaceHead | None = None, profile: str = "password_only") -> NativeWorkspace: ...
    @staticmethod
    def import_authenticated_bundle(tenant: str, control_path: str, vault_path: str, password: bytes, record_id: bytes, bundle: bytes, source_namespace: bytes, source_head: WorkspaceHead, operation_id: bytes, request_id: bytes, approved: bool, *, profile: str = "password_only") -> NativeWorkspace: ...
    @staticmethod
    def reconcile_existing(tenant: str, control_path: str, vault_path: str, request_id: bytes) -> dict[str, Any]: ...
    def head(self, tenant: str) -> WorkspaceHead: ...
    def namespace(self, tenant: str) -> bytes: ...
    def record_revision(self, tenant: str) -> int: ...
    def prepare(self, tenant: str, text: str, findings: list[dict[str, Any]], operation_id: bytes) -> PreparedChange: ...
    def prepare_batch(self, tenant: str, inputs: list[dict[str, Any]], operation_id: bytes) -> PreparedChange: ...
    def prepare_review(self, tenant: str, inputs: list[dict[str, Any]], operation_id: bytes) -> PreparedChange: ...
    def review(self, tenant: str, input: dict[str, Any]) -> dict[str, Any]: ...
    def recall(self, tenant: str, text: str) -> dict[str, Any]: ...
    def prepare_conversation_send(self, tenant: str, inputs: list[dict[str, Any]], operation: dict[str, Any]) -> PreparedChange: ...
    def prepare_observed_send(self, tenant: str, intent: dict[str, Any], logical_id: bytes, surface: str, site_id: str, operation: dict[str, Any]) -> PreparedChange: ...
    def prepare_definitely_not_sent(self, tenant: str, intent: dict[str, Any], logical_id: bytes, operation: dict[str, Any]) -> PreparedChange: ...
    def prepare_policy_changes(self, tenant: str, edits: dict[str, Any], operation_id: bytes) -> PreparedChange: ...
    def prepare_recovery(self, tenant: str, operation_id: bytes) -> PreparedChange: ...
    def commit(self, tenant: str, change: PreparedChange, approved: bool, request_id: bytes) -> dict[str, Any]: ...
    def reconcile(self, tenant: str, request_id: bytes) -> dict[str, Any]: ...
    def restore(self, tenant: str, text: str) -> str: ...
    def restore_in_conversation(self, tenant: str, text: str, logical_id: bytes) -> str: ...
    def restore_report(self, tenant: str, text: str) -> dict[str, Any]: ...
    def restore_report_in_conversation(self, tenant: str, text: str, logical_id: bytes) -> dict[str, Any]: ...
    def counts(self, tenant: str) -> dict[str, int]: ...
    def operations(self, tenant: str) -> list[dict[str, Any]]: ...
    def history_coverage(self, tenant: str) -> dict[str, Any]: ...
    def policy(self, tenant: str) -> dict[str, Any]: ...
    def conversation(self, tenant: str, logical_id: bytes) -> dict[str, Any]: ...
    def send_intent_status(self, tenant: str, intent: dict[str, Any]) -> str: ...
    def restore_stream(self, tenant: str, encoding: str = "utf8", *, progressive: bool = False, logical_id: bytes | None = None) -> RestoreStream: ...
    def lock(self, tenant: str) -> None: ...
    def close(self, tenant: str) -> None: ...
