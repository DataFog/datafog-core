{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G1 provider capture metadata (review draft)",
  "description": "Offline capture proposal only. Every null observation must appear, and every non-null observation must not appear, in unavailableMetadata; the executable validator also checks this cross-field constraint and local prompt/fixture hashes. No credentials, headers or restored private strings are metadata fields. A captured response never implies qualification.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "recordKind": {
      "enum": [
        "provider_capture",
        "protocol_test"
      ]
    },
    "provider": {
      "enum": [
        "chatgpt",
        "claude",
        "gemini"
      ]
    },
    "executionSurface": {
      "enum": [
        "web",
        "api"
      ]
    },
    "modelLabel": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reportedModelId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "modelVersion": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "promptId": {
      "enum": [
        "summarize",
        "reply",
        "table",
        "rewrite",
        "followup"
      ]
    },
    "promptSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fixtureManifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sampling": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        },
        "topP": {
          "type": [
            "number",
            "null"
          ]
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "maxOutputTokens": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "temperature",
        "topP",
        "seed",
        "maxOutputTokens"
      ],
      "additionalProperties": false
    },
    "unavailableMetadata": {
      "type": "array",
      "items": {
        "enum": [
          "reportedModelId",
          "modelVersion",
          "providerRequestId",
          "sampling.temperature",
          "sampling.topP",
          "sampling.seed",
          "sampling.maxOutputTokens",
          "usage.inputTokens",
          "usage.outputTokens",
          "usage.costAmount",
          "usage.currency",
          "usage.tokenizerId",
          "usage.tokenizerVersion"
        ]
      },
      "uniqueItems": true
    },
    "usage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "outputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "costAmount": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "tokenizerId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "tokenizerVersion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "inputTokens",
        "outputTokens",
        "costAmount",
        "currency",
        "tokenizerId",
        "tokenizerVersion"
      ],
      "additionalProperties": false
    },
    "providerRequestId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "\\S"
    },
    "responseTruncated": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "recordKind",
    "provider",
    "executionSurface",
    "modelLabel",
    "reportedModelId",
    "modelVersion",
    "capturedAt",
    "promptId",
    "promptSha256",
    "fixtureManifestSha256",
    "sampling",
    "unavailableMetadata",
    "usage",
    "providerRequestId",
    "responseTruncated"
  ],
  "additionalProperties": false
}
