{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "DataFog Core",
  "description": "PII detection and privacy transformations for Rust, Python, Node.js, and browsers",
  "colors": {
    "primary": "#795900",
    "light": "#F7BE36",
    "dark": "#795900"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "light": "#E5E2E1",
      "dark": "#131313"
    }
  },
  "logo": {
    "light": "/images/datafog-wordmark-light.svg",
    "dark": "/images/datafog-wordmark.svg"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "heading": {
      "family": "Hanken Grotesk",
      "weight": 600
    },
    "body": {
      "family": "Inter"
    }
  },
  "seo": {
    "metatags": {
      "og:image": "https://datafog.ai/datafog-icon-512.png",
      "twitter:image": "https://datafog.ai/datafog-icon-512.png",
      "twitter:card": "summary"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "get-started/installation",
          "get-started/quickstart"
        ]
      },
      {
        "group": "Core concepts",
        "pages": [
          "concepts/findings-and-ranges",
          "concepts/privacy-transformations",
          "reference/german-entities",
          "reference/jwt",
          "reference/bearer-token",
          "reference/private-keys",
          "reference/api-keys",
          "reference/uuid",
          "reference/us-routing-number",
          "reference/npi",
          "reference/credential-uri"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/migrating-from-datafog-python",
          "guides/configuration",
          "guides/pseudonymization",
          "guides/tokenization-and-restoration",
          "guides/person-discovery"
        ]
      },
      {
        "group": "SDK reference",
        "pages": [
          "reference/rust",
          "reference/python",
          "reference/node",
          "reference/browser-wasm",
          "reference/errors",
          "reference/capabilities",
          "reference/compatibility"
        ]
      },
      {
        "group": "Releases",
        "pages": [
          "releases/0-4-1",
          "releases/0-4-0",
          "releases/0-3-1",
          "releases/0-3-0"
        ]
      },
      {
        "group": "Research",
        "pages": [
          "research/local-pii-model",
          "research/local-pii-methodology"
        ]
      },
      {
        "group": "Contributing",
        "pages": [
          "development"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/DataFog/datafog-core",
          "icon": "github"
        }
      ]
    }
  }
}
