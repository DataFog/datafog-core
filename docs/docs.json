{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "DataFog",
  "description": "Local file protection with DataFog MCP and privacy SDKs with DataFog Core",
  "colors": {
    "primary": "#8A5D00",
    "light": "#8A5D00",
    "dark": "#F7CE7A"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "background": {
    "color": {
      "light": "#F2F0EB",
      "dark": "#1B1A17"
    }
  },
  "logo": {
    "light": "/images/datafog-wordmark-light.svg",
    "dark": "/images/datafog-wordmark.svg"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "heading": {
      "family": "Hanken Grotesk",
      "weight": 600,
      "source": "/fonts/hanken-grotesk-latin.woff2",
      "format": "woff2"
    },
    "body": {
      "family": "Hanken Grotesk",
      "weight": 400,
      "source": "/fonts/hanken-grotesk-latin.woff2",
      "format": "woff2"
    }
  },
  "seo": {
    "metatags": {
      "og:image": "https://docs.datafog.ai/images/og-docs.png",
      "twitter:image": "https://docs.datafog.ai/images/og-docs.png",
      "twitter:card": "summary_large_image",
      "theme-color": "#F2F0EB",
      "og:image:width": "1200",
      "og:image:height": "630",
      "og:image:type": "image/png",
      "og:image:alt": "DataFog documentation \u2014 Guides for MCP and Core SDK.",
      "twitter:image:alt": "DataFog documentation \u2014 Guides for MCP and Core SDK.",
      "og:site_name": "DataFog documentation"
    }
  },
