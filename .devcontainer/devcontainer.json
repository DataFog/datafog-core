{
  "name": "DataFog Core",
  "image": "ubuntu:24.04@sha256:2198e4c65076e9cb0b3d695219df667c0e3b0072da64ca3c2648aca17dcecaf5",
  "remoteUser": "ubuntu",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "containerEnv": {
    "CARGO_HOME": "/opt/cargo",
    "RUSTUP_HOME": "/opt/rustup",
    "PLAYWRIGHT_BROWSERS_PATH": "/opt/pw-browsers",
    "PATH": "/opt/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "ubuntu",
      "installZsh": false
    },
    "ghcr.io/datafog/devcontainer-features/build-tools:1": {},
    "ghcr.io/datafog/devcontainer-features/node-pinned:1": {
      "version": "24"
    },
    "ghcr.io/datafog/devcontainer-features/python-tools:1": {
      "pip_packages": "maturin huggingface_hub"
    },
    "ghcr.io/datafog/devcontainer-features/rust-pinned:1": {
      "toolchain": "1.88.0",
      "components": "rustfmt,clippy",
      "targets": "wasm32-unknown-unknown",
      "wasm_bindgen": "0.2.127"
    },
    "ghcr.io/datafog/devcontainer-features/playwright:1": {
      "version": "1.62.1"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "ms-python.python"
      ]
    }
  }
}
